# Environment variables. On Vercel set them under Project > Settings > Environment Variables.
# For local work copy this file to .env (it is git-ignored) and fill it in. Keep each value on one line, no quotes.

# Supabase (database + photo storage)
# Project URL, like https://abcdefgh.supabase.co
SUPABASE_URL=
# The sb_secret_... key (Project Settings > API Keys). Server only: never put it in website code.
SUPABASE_SERVICE_ROLE_KEY=
# The sb_publishable_... key (Project Settings > API Keys). Safe to be public: it can only read the published copy.
# With it, admin changes appear on the website within seconds instead of after the rebuild.
SUPABASE_PUBLISHABLE_KEY=

# Admin sign-in (first login; afterwards the Account page in the dashboard takes over).
# `npm run admin:credentials` prints a strong set of these three values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random 32+ characters; signs the login cookie.
SESSION_SECRET=

# Vercel > Settings > Git > Deploy Hooks. Saving in the admin calls it so the live site rebuilds.
DEPLOY_HOOK_URL=

# Public address of the site (canonical links, sitemap, QR contact card).
SITE_URL=https://www.prof-chandrashekhar.com
